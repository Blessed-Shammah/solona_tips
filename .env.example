# ─── SolTip configuration ────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit a real .env.local.

# Solana cluster. Safety: develop and TEST on "devnet" so you don't spend real
# money. Flip to "mainnet" only when you are ready to collect real funds.
#   devnet  | mainnet
SOLANA_CLUSTER=devnet

# RPC endpoint for the chosen cluster. A paid RPC (Helius/Triton/QuickNode) is
# strongly recommended for mainnet — public endpoints rate-limit and drop polls.
#   devnet  example: https://api.devnet.solana.com
#   mainnet example: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.devnet.solana.com

# YOUR wallet address — where funds land. This is the only place money goes.
# It is a PUBLIC key (safe to expose). No private key ever lives in this app
# (Safety Law #7: the app is non-custodial and never signs).
MERCHANT_ADDRESS=

# Human-readable name shown in the payer's wallet and on the pay page.
MERCHANT_LABEL=SolTip

# Optional shared secret to protect the merchant "create link" page and the
# /api/reconcile cron endpoint. If set, the UI prompts for it and the cron must
# send  Authorization: Bearer <this>.
ADMIN_SECRET=

# Helius webhook secret — set this AND configure a Helius webhook for MERCHANT_ADDRESS with this
# value as its Auth Header to get instant settlement (POST /api/webhooks/helius). The poller stays
# as a backstop, so this is optional.
HELIUS_WEBHOOK_SECRET=

# Merchant signing key — ONLY needed to execute live token refunds. Accepts a Solana CLI JSON byte
# array, base58 secret key, or base64-encoded 32/64-byte key. Keep it out of source and logs. If
# unset, refund rows are recorded as manual_required.
MERCHANT_SECRET_KEY=

# Where the SQLite ledger file lives (created automatically).
DATABASE_PATH=./data/soltip.db

# ─── Platform (agent-payable tools) ──────────────────────────────────────────
# Price of the Pro plan, in USD (charged on-chain). Small default eases devnet testing.
PRO_PRICE_USD=29.00

# Internal reconcile cron (built in). Disable on serverless and use a platform cron instead.
RECONCILE_INTERVAL_MS=60000
# ENABLE_RECONCILE_CRON=false

# Multi-instance scale: set REDIS_URL so rate limits are shared across app processes. Also disable
# the internal cron and schedule /api/reconcile externally so multiple instances do not poll at once.
# REDIS_URL=redis://:password@host:6379/0

# Public site URL (used for absolute OG/share links). Set on deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI blog generation (optional) ───────────────────────────────────────────
# The blog writer + AI tools work with ANY ONE of these keys (first one present wins):
#   AI_GATEWAY_API_KEY            → any model via "provider/model" strings (recommended)
#   ANTHROPIC_API_KEY             → Claude
#   OPENAI_API_KEY                → GPT
#   GOOGLE_GENERATIVE_AI_API_KEY  → Gemini
# Generate drafts: `npm run blog:generate -- "topic"` (or POST /api/blog/generate, admin-gated).
# Drafts save reviewed:false and must be human-approved (set reviewed:true) to publish.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
BLOG_MODEL=
# AI_TOOLS_MODEL=

# ─── AI tools (optional) ─────────────────────────────────────────────────────
# AI-powered catalog tools (e.g. ai-summarize). Uses whichever AI key above is set.
AI_TOOLS_ENABLED=true
